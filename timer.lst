    39                                  timer:
    40 00000066 50                          push ax
    41 00000067 2EFF06[2C00]                inc word[cs:tick]
    42 0000006C 2E833E[2C00]12              cmp word[cs:tick],18  ; Wait for 18 ticks (approximately 1 second)
    43 00000072 7523                        jne skip
    44                                      
    45                                      ; Reset tick counter and decrement time
    46 00000074 2EC706[2C00]0000            mov word[cs:tick],0
