    93                              <1> ; ============ MENU TITLE DISPLAY ============
    94                              <1> print_menu_title:
    95 00000514 60                  <1>     pusha
    96 00000515 B800B8              <1>     mov ax, 0xb800
    97 00000518 8EC0                <1>     mov es, ax
    98 0000051A BB[B604]            <1>     mov bx, title_data      ; point to title data array
    99                              <1>     
   100                              <1>     title_display_loop:
   101 0000051D 8B37                <1>     mov si, [bx]            ; get string pointer
   102 0000051F 85F6                <1>     test si, si             ; check for end marker (0)
   103 00000521 7430                <1>     jz display_subtitle
   104                              <1>     
   105                              <1>     ; Calculate screen position for this line
   106 00000523 8B4702              <1>     mov ax, [bx+2]          ; row position
   107 00000526 BA5000              <1>     mov dx, 80
   108 00000529 F7E2                <1>     mul dx
   109 0000052B 034704              <1>     add ax, [bx+4]          ; column position
   110 0000052E D1E0                <1>     shl ax, 1
   111 00000530 89C7                <1>     mov di, ax
   112                              <1>     
   113 00000532 B44F                <1>     mov ah, 0x4F            ; red background, white text
   114                              <1>     
   115                              <1>     character_loop:
   116 00000534 AC                  <1>     lodsb                   ; load next character
   117 00000535 84C0                <1>     test al, al             ; check for null terminator
   118 00000537 7415                <1>     jz next_title_line
   119                              <1>     
   120 00000539 3C23                <1>     cmp al, '#'             ; check if it's part of letter
   121 0000053B 7507                <1>     jne space_character
   122                              <1>     
   123                              <1>     ; Draw letter part (black on red)
   124 0000053D 26C7052007          <1>     mov word [es:di], 0x0720  ; black background for letters
   125 00000542 EB05                <1>     jmp next_character
   126                              <1>     
   127                              <1>     space_character:
   128                              <1>     ; Draw background (red)
   129 00000544 26C705204F          <1>     mov word [es:di], 0x4F20  ; red background for spaces
   130                              <1>     
   131                              <1>     next_character:
   132 00000549 83C702              <1>     add di, 2
   133 0000054C EBE6                <1>     jmp character_loop
   134                              <1> 
   135                              <1>     next_title_line:
   136 0000054E 83C306              <1>     add bx, 6               ; move to next title line data
   137 00000551 EBCA                <1>     jmp title_display_loop
   138                              <1> 
   139                              <1>     display_subtitle:
   140                              <1>     ; Position subtitle below main title
   141 00000553 B82C04              <1>     mov ax, 13 * 80 + 28    ; row 13, column 28
   142 00000556 D1E0                <1>     shl ax, 1
   143 00000558 89C7                <1>     mov di, ax
   144                              <1>     
   145 0000055A BE[0A04]            <1>     mov si, menu_subtitle
   146 0000055D B440                <1>     mov ah, 0x40            ; red background, black text
   147                              <1>     
   148                              <1>     subtitle_character_loop:
   149 0000055F AC                  <1>     lodsb
   150 00000560 84C0                <1>     test al, al             ; check for null terminator
   151 00000562 7403                <1>     jz title_display_done
   152 00000564 AB                  <1>     stosw                   ; store character with attribute
   153 00000565 EBF8                <1>     jmp subtitle_character_loop
   154                              <1> 
   155                              <1>     title_display_done:
   156 00000567 61                  <1>     popa
   157 00000568 C3                  <1>     ret
