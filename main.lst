    92 00000426 2EFF2E[B203]                jmp far [cs:old]
    93                                  
    94                                  no_chain2:
    95 0000042B CF                          iret
    96                                  
    97                                  ; --- Rewritten repeater: draw all balloons each frame, then move them up ---
    98                                  repeater:
    99 0000042C 60                          pusha
   100                                  
   101                                  main_loop:
   102                                      ; Check if time expired
   103 0000042D 2E833E[BA03]00              cmp word [cs:current_time], 0
   104 00000433 0F8E8900                    jle end_repeater
   105                                  
   106                                      ; --- Draw ALL balloons for this frame ---
   107 00000437 BE0000                      mov si, 0          ; index 0..BALL_COUNT-1
   108                                  
   109                                  draw_loop:
   110 0000043A 83FE03                      cmp si, BALL_COUNT
   111 0000043D 7D26                        jge after_draws
   112                                  
   113                                      ; compute offset = si * 2 for dw arrays
   114 0000043F 89F3                        mov bx, si
   115 00000441 D1E3                        shl bx, 1          ; bx = si*2
   116                                  
   117                                      ; load row and col
   118 00000443 2E8B97[0300]                mov dx, [cs:ball_rows + bx]    ; row in DX (word)
   119 00000448 2E8B87[0900]                mov ax, [cs:ball_cols + bx]    ; column in AX (word)
   120                                      ; load char
   121 0000044D 2E8A84[0F00]                mov al, [cs:ball_chars + si]   ; character in AL
   122 00000452 B400                        mov ah, 0                      ; keep AH zero so AX is char in AL
   123                                  
   124                                      ; PUSH in same order as your original calls:
   125                                      ; original used: push char, push col, push row, call draw
   126 00000454 50                          push ax              ; push char (AX: AL contains char)
   127 00000455 2EFFB7[0900]                push word [cs:ball_cols + bx] ; push col
   128 0000045A 2EFFB7[0300]                push word [cs:ball_rows + bx] ; push row
   129 0000045F E8B0FB                      call draw
   130                                  
   131 00000462 46                          inc si
   132 00000463 EBD5                        jmp draw_loop
   133                                  
   134                                  after_draws:
   135                                      ; frame delay and then clear (single clear per frame)
   136 00000465 E848FC                      call delay
   137 00000468 E824FC                      call clear
   138                                  
   139                                      ; --- Move all balloons up and respawn when reached top ---
   140 0000046B BE0000                      mov si, 0
   141                                  
   142                                  move_loop:
   143 0000046E 83FE03                      cmp si, BALL_COUNT
   144 00000471 7D32                        jge draw_ui
   145                                  
   146 00000473 89F3                        mov bx, si
   147 00000475 D1E3                        shl bx, 1
   148                                      ; decrement row
   149 00000477 2EFF8F[0300]                dec word [cs:ball_rows + bx]
   150                                  
   151                                      ; if row <= 0 then respawn at bottom and adjust column
   152 0000047C 2E8B87[0300]                mov ax, [cs:ball_rows + bx]
   153 00000481 83F801                      cmp ax, 1
   154 00000484 7F1C                        jg next_move
   155                                  
   156                                      ; respawn
   157 00000486 2EC787[0300]1700            mov word [cs:ball_rows + bx], 23
   158                                  
   159                                      ; advance column a bit (to give variety), wrap if off-screen
   160 0000048D 2E8B87[0900]                mov ax, [cs:ball_cols + bx]
   161 00000492 83C007                      add ax, 7
   162 00000495 83F846                      cmp ax, 70
   163 00000498 7E03                        jle store_col
   164 0000049A B80A00                      mov ax, 10
   165                                  store_col:
   166 0000049D 2E8987[0900]                mov [cs:ball_cols + bx], ax
   167                                  
   168                                  next_move:
   169 000004A2 46                          inc si
   170 000004A3 EBC9                        jmp move_loop
   171                                  
   172                                  draw_ui:
   173                                      ; Draw Score
   174 000004A5 6A00                        push 0
   175 000004A7 68[A003]                    push inst
   176 000004AA FF36[AE03]                  push word [size]
   177 000004AE E8BCFE                      call print
   178                                  
   179                                      ; Draw Time
   180 000004B1 6A28                        push 40
   181 000004B3 68[A703]                    push inst1
   182 000004B6 FF36[B003]                  push word [size1]
   183 000004BA E8B0FE                      call print
   184                                  
   185 000004BD E96DFF                      jmp main_loop
   186                                  
   187                                  end_repeater:
   188 000004C0 61                          popa
   189 000004C1 C3                          ret
   190                                  
   191                                  start:
   192 000004C2 E89EFE                      call starter
   193                                      
   194                                  key:   
   195 000004C5 B400                        mov ah, 0
   196 000004C7 CD16                        int 16h
   197 000004C9 80FC01                      cmp ah, 0x01        ; Escape key
   198 000004CC 745C                        je end
   199 000004CE 80FC39                      cmp ah, 0x39        ; Spacebar
   200 000004D1 75F2                        jne key
   201                                  
   202 000004D3 E8B9FB                      call clear  
   203 000004D6 31C0                        xor ax, ax
   204 000004D8 8EC0                        mov es, ax
   205                                      
   206                                      ; Save old timer ISR
   207 000004DA 26A12000                    mov ax, [es:8*4]
   208 000004DE 2EA3[B203]                  mov word [cs:old], ax
   209 000004E2 26A12200                    mov ax, [es:8*4+2]
   210 000004E6 2EA3[B403]                  mov word [cs:old+2], ax
   211                                      
   212                                      ; Set up timer interrupt
   213 000004EA FA                          cli 
   214 000004EB 26C7062000[BC03]            mov word [es:8*4], timer   
   215 000004F2 268C0E2200                  mov word [es:8*4+2], cs
   216 000004F7 FB                          sti
   217                                      
   218                                      ; Print initial score and time
   219 000004F8 6A00                        push 0               ; position for score
   220 000004FA 68[A003]                    push inst            ; score string
   221 000004FD FF36[AE03]                  push word [size]     ; score string length
   222 00000501 E869FE                      call print
   223                                      
   224 00000504 6A28                        push 40              ; position for time  
   225 00000506 68[A703]                    push inst1           ; time string
   226 00000509 FF36[B003]                  push word [size1]    ; time string length
   227 0000050D E85DFE                      call print
   228                                      
   229                                      ; Start balloon animation
   230 00000510 E819FF                      call repeater
   231                                      
   232                                      ; Set done flag and restore old ISR when finished
   233 00000513 2EC706[B603]0100            mov word [cs:done], 1
   234 0000051A 2EA1[B203]                  mov ax, [cs:old]
   235 0000051E 26A32000                    mov [es:8*4], ax
   236 00000522 2EA1[B403]                  mov ax, [cs:old+2]
   237 00000526 26A32200                    mov [es:8*4+2], ax
   238                                  
   239                                  end:
   240 0000052A B8004C                      mov ax, 0x4c00
   241 0000052D CD21                        int 0x21
