   309 00000707 2EFF36[4F04]                push word [cs:ball_cols + 2]   ; column
   310 0000070C 2EFF36[4904]                push word [cs:ball_rows + 2]   ; row
   311 00000711 E8EFF8                      call draw
   312                                  
   313                                  check_balloon3:
   314                                      ; Update and draw balloon 3 (activated after longer delay)
   315 00000714 2E803E[6D04]01              cmp byte [cs:balloon3_active], 1
   316 0000071A 7536                        jne update_ui
