    62                              <1> ; ============ STRING PRINT FUNCTION ============
    63                              <1> print_string:
    64 000004EB 55                  <1>     push bp
    65 000004EC 89E5                <1>     mov bp, sp
    66 000004EE 60                  <1>     pusha
    67                              <1>     
    68 000004EF B800B8              <1>     mov ax, 0xb800
    69 000004F2 8EC0                <1>     mov es, ax
    70                              <1>     
    71                              <1>     ; Calculate screen position: (row * 80 + col) * 2
    72 000004F4 8B460A              <1>     mov ax, [bp+10]         ; row number
    73 000004F7 BB5000              <1>     mov bx, 80
    74 000004FA F7E3                <1>     mul bx
    75 000004FC 034608              <1>     add ax, [bp+8]          ; column number  
    76 000004FF D1E0                <1>     shl ax, 1               ; multiply by 2 for attribute
    77 00000501 89C7                <1>     mov di, ax
