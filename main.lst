   330 00000742 B400                        mov ah, 0
   331 00000744 50                          push ax                        ; push letter
   332 00000745 2EFF36[5104]                push word [cs:ball_cols + 4]   ; column
   333 0000074A 2EFF36[4B04]                push word [cs:ball_rows + 4]   ; row
   334 0000074F E8B1F8                      call draw
