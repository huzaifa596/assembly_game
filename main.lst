    16                                  ; ==================== RANDOM NUMBER GENERATION ====================
    17                                  ; Better random number generator (returns 0-255 in AL)
    18                                  generate_random:
    19 000004FE 53                          push bx
    20 000004FF 52                          push dx
    21                                      
    22                                      ; Improved LCG with better parameters
    23 00000500 2EA1[5604]                  mov ax, [cs:random_seed]
    24 00000504 BB4D35                      mov bx, 13645
    25 00000507 F7E3                        mul bx
    26 00000509 05013E                      add ax, 15873
    27 0000050C 2EA3[5604]                  mov [cs:random_seed], ax
    28                                      
    29                                      ; Use the high byte for more randomness
    30 00000510 88E0                        mov al, ah
    31                                      
    32 00000512 5A                          pop dx
    33 00000513 5B                          pop bx
