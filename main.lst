   300 000006F2 E832FE                      call generate_random_column    ; new random position
   301 000006F5 2EA3[4F04]                  mov [cs:ball_cols + 2], ax
   302 000006F9 E819FE                      call generate_random_letter    ; new random letter
   303 000006FC 2EA2[5404]                  mov [cs:ball_letters + 1], al
