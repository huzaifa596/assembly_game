    43 0000051C 3C1A                        cmp al, 26
    44 0000051E 7202                        jb letter_ok
    45 00000520 2C06                        sub al, 6           ; if 26-31, make it 20-25
    46                                  letter_ok:
    47 00000522 0441                        add al, 'A'         ; convert to 'A'-'Z'
    48                                      
    49 00000524 5A                          pop dx
    50 00000525 5B                          pop bx
    51 00000526 C3                          ret
